# AI Emergency Response System Environment Variables

# Demo Mode Toggle (OFF by default for live production OpenStreetMap searches)
DEMO_MODE=false

# Google Places API Credentials (Optional - Required for official Google Places Nearby Search)
# If left as placeholder, system uses live OpenStreetMap Overpass API without mock fallback
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key_here

# OpenStreetMap / Overpass API Endpoint (Free & Open Source - No API Key Required)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# OpenAI API Key (Required for live Whisper speech-to-text & GPT-4o analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase PostgreSQL Credentials
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email Alert Dispatch Credentials (Resend API)
EMAIL_API_KEY=your_resend_api_key_here
EMAIL_FROM=alerts@resend.dev

